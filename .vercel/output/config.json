{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro(?:/(.*))$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/about/?$",
			"dest": "_render"
		},
		{
			"src": "^/ai/?$",
			"dest": "_render"
		},
		{
			"src": "^/core/?$",
			"dest": "_render"
		},
		{
			"src": "^/edge/?$",
			"dest": "_render"
		},
		{
			"src": "^/ion/?$",
			"dest": "_render"
		},
		{
			"src": "^/omnio/?$",
			"dest": "_render"
		},
		{
			"src": "^/xenvio/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render"
		}
	]
}