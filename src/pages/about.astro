---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Acerca">
  <div class="about-page">
    <a href="/" class="back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      Dashboard
    </a>

    <h1 class="page-title">Acerca de NOVACREST</h1>

    <div class="content">
      <section class="block">
        <h2>¿Qué es NOVACREST?</h2>
        <p>
          NOVACREST es la <strong>plataforma inteligente de orquestación logística</strong> — el sistema nervioso
          centralizado para cadenas de suministro modernas. Interfaces humano-céntricas que hacen la logística compleja
          un placer de usar, con resiliencia zero-error a cualquier volumen.
        </p>
      </section>

      <section class="block">
        <h2>Los 6 Módulos</h2>
        <div class="modules-list">
          <div class="module-item" style="--m-color: #4FC3F7;">
            <img src="/logos/core.svg" alt="Shipedge" class="module-logo" />
            <div>
              <strong>CORE — Shipedge</strong> — Full WMS para centros de distribución y 3PLs. Multi-tenant, facturación automatizada, integración robótica.
            </div>
          </div>
          <div class="module-item" style="--m-color: #7db4e8;">
            <img src="/logos/omnio.svg" alt="OmniOrders" class="module-logo" />
            <div>
              <strong>OMNIO — OmniOrders</strong> — Gestión distribuida de órdenes. Proximity routing, order splitting, sync multi-canal.
            </div>
          </div>
          <div class="module-item" style="--m-color: #ddb897;">
            <img src="/logos/xenvio.svg" alt="Xenvio" class="module-logo" />
            <div>
              <strong>XENVIO</strong> — Multi-carrier rate shopping y labels. 50+ carriers, 100M+ labels generadas.
            </div>
          </div>
          <div class="module-item" style="--m-color: #b497dd;">
            <img src="/logos/ion.svg" alt="iond" class="module-logo" />
            <div>
              <strong>ION — iond.ai</strong> — Plataforma de integración AI-native. ionMind + ionFlow + ionCLI.
            </div>
          </div>
          <div class="module-item" style="--m-color: #66BB6A;">
            <img src="/logos/edge.svg" alt="BinLogic" class="module-logo" />
            <div>
              <strong>EDGE — BinLogic</strong> — Ejecución de warehouse y manejo de materiales. Smart putaway, wave picking, labor management.
            </div>
          </div>
          <div class="module-item" style="--m-color: #97ddd2;">
            <img src="/logos/novacrest.svg" alt="Novacrest" class="module-logo" />
            <div>
              <strong>AI — Novacrest Intelligence</strong> — BI centralizado, ML forecasting, Edge AI, ISO 27001.
            </div>
          </div>
        </div>
      </section>

      <section class="block">
        <h2>Métricas del Ecosistema</h2>
        <div class="metrics">
          <div class="metric">
            <span class="metric-value">$1.7B+</span>
            <span class="metric-label">GMV procesado anualmente</span>
          </div>
          <div class="metric">
            <span class="metric-value">100M+</span>
            <span class="metric-label">Shipping labels generadas</span>
          </div>
          <div class="metric">
            <span class="metric-value"><50ms</span>
            <span class="metric-label">Latencia promedio de API</span>
          </div>
          <div class="metric">
            <span class="metric-value">99.97%</span>
            <span class="metric-label">Tasa de entrega a tiempo</span>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    max-width: 760px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--accent-green);
  }

  .page-title {
    font-size: 2.2rem;
    font-weight: 800;
    margin-bottom: 2rem;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .block h2 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border-color);
  }

  .block p, .block li {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .modules-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .module-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .module-logo {
    height: 24px;
    width: auto;
    min-width: 60px;
    max-width: 100px;
    object-fit: contain;
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    text-align: center;
  }

  .metric-value {
    font-size: 1.5rem;
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--accent-green);
  }

  .metric-label {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  @media (max-width: 480px) {
    .metrics {
      grid-template-columns: 1fr;
    }
  }
</style>
