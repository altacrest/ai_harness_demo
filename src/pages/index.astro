---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';

const products = [
  {
    name: 'CORE',
    slug: 'core',
    description: 'Full WMS para centros de distribución y 3PLs. Arquitectura multi-tenant con workflows específicos por cliente, automatización de facturación e integración robótica.',
    logo: '/logos/core.svg',
    accentColor: '#4FC3F7',
    tags: ['WMS', '3PL', 'Multi-Tenant', 'Robotics'],
    status: 'active' as const,
  },
  {
    name: 'OMNIO',
    slug: 'omnio',
    description: 'Gestión distribuida de órdenes con sincronización de inventario en tiempo real y enrutamiento inteligente por proximidad. Precisión zero-error en todos los canales.',
    logo: '/logos/omnio.svg',
    accentColor: '#7db4e8',
    tags: ['OMS', 'Proximity Routing', 'Order Splitting', 'Go + Dragonfly'],
    status: 'active' as const,
  },
  {
    name: 'XENVIO',
    slug: 'xenvio',
    description: 'Rate shopping multi-carrier y generación de etiquetas — 50+ carriers. Rate shopping en tiempo real entre carriers regionales, internacionales y principales.',
    logo: '/logos/xenvio.svg',
    accentColor: '#ddb897',
    tags: ['Shipping', 'Rate Shopping', 'Labels', '50+ Carriers'],
    status: 'active' as const,
  },
  {
    name: 'ION',
    slug: 'ion',
    description: 'La plataforma de integración AI-native que hace cada conexión inteligente, sin esfuerzo y siempre activa. Powered by ionMind + ionFlow + ionCLI.',
    logo: '/logos/ion.svg',
    accentColor: '#b497dd',
    tags: ['iPaaS', 'Visual Flows', 'Headless Daemon', 'Auto-API'],
    status: 'active' as const,
  },
  {
    name: 'EDGE',
    slug: 'edge',
    description: 'Ejecución de warehouse y manejo de materiales — armonía entre humanos y robots. Integración nativa con ASRS, AMR y sistemas de automatización.',
    logo: '/logos/edge.svg',
    accentColor: '#66BB6A',
    tags: ['Warehouse', 'Execution', 'Material Handling', 'Labor Mgmt'],
    status: 'active' as const,
  },
  {
    name: 'AI',
    slug: 'ai',
    description: 'Inteligencia centralizada del ecosistema. Dashboards unificados, business intelligence en tiempo real, insights con IA y reportes personalizados — todo en un solo lugar.',
    logo: '/logos/novacrest.svg',
    accentColor: '#97ddd2',
    tags: ['Intelligence', 'Dashboards', 'ML Forecasting', 'Analytics'],
    status: 'active' as const,
  },
];
---

<BaseLayout title="Dashboard">
  <section class="hero">
    <div class="hero-badge">ECOSISTEMA NOVACREST</div>
    <h1 class="hero-title">
      La Plataforma de
      <span class="hero-highlight">Orquestación Logística Inteligente</span>
    </h1>
    <p class="hero-subtitle">
      Explora los 6 pilares del ecosistema NOVACREST. Cada módulo cubre un producto clave
      del sistema nervioso centralizado para cadenas de suministro modernas.
    </p>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-value">10+</span>
        <span class="stat-label">Productos Integrados</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">$1.7B+</span>
        <span class="stat-label">GMV Procesado</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">100M+</span>
        <span class="stat-label">Labels Generadas</span>
      </div>
    </div>
  </section>

  <section class="grid">
    {products.map(product => (
      <ProductCard {...product} />
    ))}
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    text-align: center;
    padding: 3rem 0 2rem;
  }

  .hero-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--accent-green);
    border: 1px solid rgba(197, 221, 151, 0.3);
    padding: 0.3rem 1rem;
    border-radius: 20px;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .hero-highlight {
    background: linear-gradient(135deg, var(--accent-green), var(--accent-cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    max-width: 640px;
    margin: 0 auto 2rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--accent-green);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--border-color);
  }

  /* Grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.25rem;
    margin: 2rem 0 3rem;
  }

  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .hero-stats {
      flex-direction: column;
      gap: 1rem;
    }
    .stat-divider {
      width: 40px;
      height: 1px;
    }
  }
</style>
