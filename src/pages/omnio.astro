---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductPage from '../components/ProductPage.astro';
import { icons } from '../components/icons';
---

<BaseLayout title="OMNIO">
  <ProductPage
    title="OMNIO"
    subtitle="Orquestación de agentes multi-modelo. El sistema nervioso que coordina revisores paralelos, aprobadores y el flujo completo de la fábrica."
    accentColor="#7db4e8"
    icon={icons.omnio}
    videoRef="Video 3 — Programar con agentes ya no basta: monta tu Software Factory"
    concepts={[
      {
        title: 'Revisores Paralelos',
        description: 'Cuatro sub-agentes especializados corren en paralelo: Seguridad (Sol), UX (Sol), UI (Astra), Código (Sonnet). Cada uno evalúa desde su perspectiva sin esperar a los demás.'
      },
      {
        title: 'Especialización de Modelos',
        description: 'Opus para tareas de alto juicio (spec, construcción, aprobación). Sol para seguridad y UX. Astra para UI/uso de computadora. Sonnet para consistencia de código. El modelo correcto para cada trabajo.'
      },
      {
        title: 'Ciclo del Aprobador',
        description: 'Opus recibe feedback de los 4 revisores, clasifica problemas por severidad, envía correcciones al constructor y re-activa solo los revisores que fallaron. Continúa hasta aprobación unánime.'
      },
      {
        title: 'Pipeline Determinista + No-Determinista',
        description: 'La fábrica mezcla pasos de código deterministas (branches, tests, hooks) con agentes no-deterministas (escritor de specs, constructor). Cada paso deja una traza auditable.'
      },
      {
        title: 'Paralelismo y Throughput',
        description: 'Múltiples tareas corren simultáneamente, cada una con su propia branch y suite de tests. La fábrica puede procesar muchos elementos mientras los humanos duermen.'
      },
    ]}
    keyTakeaways={[
      'Agentes paralelos especializados superan al generalista individual',
      'El ciclo aprobador-constructor itera hasta calidad unánime',
      'El throughput escala con los agentes disponibles',
      'El costo se vuelve predecible por tarea',
      'Los revisores terminan aproximadamente en el tiempo del más lento',
    ]}
    relatedModules={[
      { name: 'CORE', slug: 'core', color: '#c5dd97' },
      { name: 'EDGE', slug: 'edge', color: '#dd97b4' },
      { name: 'AI', slug: 'ai', color: '#97ddd2' },
    ]}
  />
</BaseLayout>
