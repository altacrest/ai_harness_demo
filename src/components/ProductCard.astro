---
interface Props {
  name: string;
  slug: string;
  description: string;
  icon?: string;
  logo?: string;
  accentColor: string;
  tags: string[];
  status: 'active' | 'coming-soon' | 'beta';
}

const { name, slug, description, icon, logo, accentColor, tags, status } = Astro.props;
---

<a href={`/${slug}`} class="product-card" style={`--card-accent: ${accentColor};`}>
  <div class="card-glow"></div>
  <div class="card-header">
    {logo ? (
      <img src={logo} alt={name} class="card-logo" />
    ) : (
      <div class="card-icon" set:html={icon} />
    )}
    {status !== 'active' && (
      <span class={`badge badge-${status}`}>
        {status === 'coming-soon' ? 'Próximamente' : 'Beta'}
      </span>
    )}
  </div>
  <h3 class="card-title">{name}</h3>
  <p class="card-description">{description}</p>
  <div class="card-tags">
    {tags.map(tag => (
      <span class="tag">{tag}</span>
    ))}
  </div>
  <div class="card-arrow">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
  </div>
</a>

<style>
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    cursor: pointer;
  }

  .product-card:hover {
    border-color: var(--card-accent);
    background: var(--bg-card-hover);
    transform: translateY(-4px);
    box-shadow: 0 8px 40px rgba(0,0,0,0.4), 0 0 60px color-mix(in srgb, var(--card-accent) 10%, transparent);
  }

  .card-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--card-accent), transparent);
    opacity: 0;
    transition: opacity 0.35s;
  }

  .product-card:hover .card-glow {
    opacity: 1;
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .card-icon {
    width: 48px;
    height: 48px;
    color: var(--card-accent);
    opacity: 0.9;
  }

  .card-logo {
    height: 36px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    filter: brightness(0.95);
    transition: filter 0.3s;
  }

  .product-card:hover .card-logo {
    filter: brightness(1.1);
  }

  .card-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .badge {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .badge-coming-soon {
    background: rgba(221, 184, 151, 0.15);
    color: var(--accent-orange);
    border: 1px solid rgba(221, 184, 151, 0.3);
  }

  .badge-beta {
    background: rgba(180, 151, 221, 0.15);
    color: var(--accent-purple);
    border: 1px solid rgba(180, 151, 221, 0.3);
  }

  .card-title {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-primary);
  }

  .card-description {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-secondary);
    flex: 1;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .tag {
    font-size: 0.7rem;
    font-weight: 500;
    font-family: var(--font-mono);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: rgba(255,255,255,0.05);
    color: var(--text-muted);
    border: 1px solid rgba(255,255,255,0.08);
  }

  .card-arrow {
    position: absolute;
    bottom: 1.75rem;
    right: 1.75rem;
    width: 20px;
    height: 20px;
    color: var(--card-accent);
    opacity: 0;
    transform: translateX(-8px);
    transition: all 0.35s;
  }

  .product-card:hover .card-arrow {
    opacity: 0.7;
    transform: translateX(0);
  }
</style>
